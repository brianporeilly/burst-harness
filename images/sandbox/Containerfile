# Burst Harness sandbox — the image an agent-sandbox SandboxTemplate runs.
#
# The contract with the harness (checked at claim time, see
# harness/agent_sandbox.py REQUIRED_COMMANDS): a POSIX sh, git, and coreutils
# (base64, mkdir, dirname, ls, rm, cat, env), a writable /workspace, and a
# process that keeps the pod alive. Everything else is for the task: add the
# toolchains your repos need.
#
# Toolchains: Python, Node, make and gcc, and Rust (rustc and cargo from Fedora,
# with the wasm32-unknown-unknown standard library, so `cargo build --target
# wasm32-unknown-unknown` needs no rustup). For Rust, also clippy and rustfmt
# (rustup is not reachable from a sandbox), clang, lld and mold, binaryen
# (wasm-opt) and just, and cargo-binstall: `cargo binstall wasm-bindgen-cli
# --version X` fetches the release matching a project's wasm-bindgen in
# seconds. For Bevy and other games, the system libraries its default features
# build against (alsa, udev, wayland, xkbcommon, X11, Vulkan), with Mesa's
# software drivers and Xvfb, so a windowed build also runs headless.
#
# Also provides tmux (sessions that survive a dropped exec), Claude Code, and
# opencode and zellij (`harness session`).
#
# Deliberately absent: credentials of any kind, and gh. The harness clones and
# pushes with a token it passes per command, and opens PRs from the driver, so
# nothing in here can push or exfiltrate a token.
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install --setopt=install_weak_deps=False \
      git-core coreutils findutils grep sed gawk diffutils patch which procps-ng \
      tar gzip unzip jq ripgrep tmux socat \
      python3 python3-pip nodejs npm make gcc gcc-c++ pkgconf-pkg-config \
      rust cargo rust-std-static-wasm32-unknown-unknown clippy rustfmt \
      clang lld mold binaryen just \
      alsa-lib-devel systemd-devel wayland-devel libxkbcommon-devel \
      libX11-devel libXcursor-devel libXi-devel libXrandr-devel vulkan-loader-devel \
      mesa-dri-drivers mesa-vulkan-drivers xorg-x11-server-Xvfb \
 && dnf clean all \
 && cargo --version && test -d "$(rustc --print sysroot)/lib/rustlib/wasm32-unknown-unknown" \
 && cargo clippy --version && cargo fmt --version && wasm-opt --version && just --version \
 && pkg-config --exists alsa libudev wayland-client xkbcommon x11 vulkan

# UID 1000 matches the SandboxTemplate's runAsUser; a real HOME avoids tools
# writing config to / (the OpenHands UID/HOME class of bug).
RUN useradd --uid 1000 --create-home --home-dir /home/agent agent \
 && mkdir -p /workspace && chown agent:agent /workspace
USER 1000
# Claude Code sends no telemetry or error reports from here: the egress gateway
# would refuse them anyway, and each refusal is noise in the run's log. Its
# commands may run for up to an hour (30 minutes unless it asks for more): a
# first Bevy build or test run takes longer than its defaults of 2 and 10.
ENV HOME=/home/agent \
    SHELL=/bin/bash \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    BASH_DEFAULT_TIMEOUT_MS=1800000 \
    BASH_MAX_TIMEOUT_MS=3600000
WORKDIR /workspace

# Claude Code, for the harness's claude-code engine and for interactive use
# (`kubectl exec -it <pod> -- tmux new -A -s main`, then `claude`). Pinned: the
# image is immutable, so the in-place auto-updater is off and a new version is
# a rebuild. The installer runs as the agent user; the binary then moves to
# /usr/local/bin and everything the install left in $HOME is removed -- so a
# tmpfs $HOME can't hide it, and no machineID/userID is baked into every
# container.
# Holds no credentials: pass CLAUDE_CODE_OAUTH_TOKEN (from `claude
# setup-token`) or ANTHROPIC_API_KEY at run time.
ARG CLAUDE_CODE_VERSION=2.1.323
RUN curl -fsSL https://claude.ai/install.sh | bash -s "${CLAUDE_CODE_VERSION}"
USER root
RUN install -m 755 "$(readlink -f /home/agent/.local/bin/claude)" /usr/local/bin/claude \
 && rm -rf /home/agent/.local /home/agent/.claude /home/agent/.claude.json /home/agent/.cache /home/agent/.npm \
 && claude --version
# opencode, for `harness session`: its web UI is what a session serves. Pinned
# for the same reason as Claude Code; its own updater is turned off in the
# config the harness writes.
ARG OPENCODE_VERSION=1.18.35
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
 && opencode --version \
 && rm -rf /home/agent/.npm /home/agent/.cache /home/agent/.local /home/agent/.config
# zellij, for a session's optional terminal in the browser (`harness session
# start --terminal`). Its web server only listens on loopback without a
# certificate, so the harness puts socat in front of it. Pinned and checked.
ARG ZELLIJ_VERSION=0.45.1
RUN case "$(uname -m)" in \
      x86_64)  sum=40bcc2e03f5d5ae8e054e39f676081fe12ab70871506996ba595834c3718eefc ;; \
      aarch64) sum=05f0802afadd53f8db9514e7cae53c9ae8432fed1b35b8294aa816ee3044a16b ;; \
      *) echo "no zellij build for $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/zellij.tar.gz \
      "https://github.com/zellij-org/zellij/releases/download/v${ZELLIJ_VERSION}/zellij-$(uname -m)-unknown-linux-musl.tar.gz" \
 && echo "$sum  /tmp/zellij.tar.gz" | sha256sum -c - \
 && tar xzf /tmp/zellij.tar.gz -C /usr/local/bin zellij && rm /tmp/zellij.tar.gz \
 && zellij --version \
 && rm -rf /home/agent/.cache /home/agent/.config /home/agent/.local
# cargo-binstall, for installing a Rust tool's release build rather than
# compiling it (wasm-bindgen-cli at the version a project pins, trunk, ...):
# GitHub's release downloads are on the allowlist. Pinned and checked.
ARG CARGO_BINSTALL_VERSION=1.26.1
RUN case "$(uname -m)" in \
      x86_64)  sum=43d379fef8cb450961a14ff113e7bce7b5e1e52db709c776d186f928d8a20a40 ;; \
      aarch64) sum=243dbea9976495f0a5640f856283b5b3d934113381c9a1fba347c9e4b1fea142 ;; \
      *) echo "no cargo-binstall build for $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/cargo-binstall.tgz \
      "https://github.com/cargo-bins/cargo-binstall/releases/download/v${CARGO_BINSTALL_VERSION}/cargo-binstall-$(uname -m)-unknown-linux-musl.tgz" \
 && echo "$sum  /tmp/cargo-binstall.tgz" | sha256sum -c - \
 && tar xzf /tmp/cargo-binstall.tgz -C /usr/local/bin cargo-binstall && rm /tmp/cargo-binstall.tgz \
 && cargo-binstall -V
USER 1000

# Claude Code config is composed at container start by burst-sandbox-init from
# layers: image defaults (claude/ here), a mounted /config/claude directory,
# CLAUDE_JSON / CLAUDE_SETTINGS_JSON env, and files the harness uploads. See the
# script's header. Composed at start rather than baked in, so it also works with
# a read-only root and a tmpfs $HOME.
#
# Default claude.json sets hasCompletedOnboarding: without it, interactive
# `claude` runs first-run onboarding (theme, then login screens) even when
# CLAUDE_CODE_OAUTH_TOKEN is set, which looks like the token being ignored.
COPY claude/ /etc/burst-harness/claude/
COPY burst-sandbox-init /usr/local/bin/burst-sandbox-init
# Run by the harness, as root, when the gateway terminates TLS to add
# credentials: trusts that gateway's CA. See the script's header.
COPY burst-sandbox-trust /usr/local/bin/burst-sandbox-trust
# A session container's command: stays up while its gateway does.
COPY burst-sandbox-wait /usr/local/bin/burst-sandbox-wait

# Driven from outside with exec; nothing to run on its own. A pod spec must set
# `args`, not `command`, or the entrypoint (and so the config) is skipped.
ENTRYPOINT ["burst-sandbox-init", "--"]
CMD ["sleep", "infinity"]
