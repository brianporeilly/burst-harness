# Burst Harness sandbox — the image an agent-sandbox SandboxTemplate runs.
#
# The contract with the harness (checked at claim time, see
# harness/agent_sandbox.py REQUIRED_COMMANDS): a POSIX sh, git, and coreutils
# (base64, mkdir, dirname, ls, rm, cat, env), a writable /workspace, and a
# process that keeps the pod alive. Everything else is for the task: add the
# toolchains your repos need.
#
# Also provides tmux (sessions that survive a dropped exec) and Claude Code.
#
# Deliberately absent: credentials of any kind, and gh. The harness clones and
# pushes with a token it passes per command, and opens PRs from the driver, so
# nothing in here can push or exfiltrate a token.
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install --setopt=install_weak_deps=False \
      git-core coreutils findutils grep sed gawk diffutils patch which procps-ng \
      tar gzip unzip jq ripgrep tmux \
      python3 python3-pip nodejs npm make gcc gcc-c++ \
 && dnf clean all

# UID 1000 matches the SandboxTemplate's runAsUser; a real HOME avoids tools
# writing config to / (the OpenHands UID/HOME class of bug).
RUN useradd --uid 1000 --create-home --home-dir /home/agent agent \
 && mkdir -p /workspace && chown agent:agent /workspace
USER 1000
ENV HOME=/home/agent \
    DISABLE_AUTOUPDATER=1
WORKDIR /workspace

# Claude Code, for the harness's claude-code engine and for interactive use
# (`kubectl exec -it <pod> -- tmux new -A -s main`, then `claude`). Pinned: the
# image is immutable, so the in-place auto-updater is off and a new version is
# a rebuild. The installer runs as the agent user; the binary then moves to
# /usr/local/bin and everything the install left in $HOME is removed -- so a
# tmpfs $HOME can't hide it, and no machineID/userID is baked into every
# container.
# Holds no credentials: pass CLAUDE_CODE_OAUTH_TOKEN (from `claude
# setup-token`) or ANTHROPIC_API_KEY at run time.
ARG CLAUDE_CODE_VERSION=2.1.285
RUN curl -fsSL https://claude.ai/install.sh | bash -s "${CLAUDE_CODE_VERSION}"
USER root
RUN install -m 755 "$(readlink -f /home/agent/.local/bin/claude)" /usr/local/bin/claude \
 && rm -rf /home/agent/.local /home/agent/.claude /home/agent/.claude.json /home/agent/.cache /home/agent/.npm \
 && claude --version
USER 1000

# Claude Code config is composed at container start by burst-sandbox-init from
# layers: image defaults (claude/ here), a mounted /config/claude directory,
# CLAUDE_JSON / CLAUDE_SETTINGS_JSON env, and files the harness uploads. See the
# script's header. Composed at start rather than baked in, so it also works with
# a read-only root and a tmpfs $HOME.
#
# Default claude.json sets hasCompletedOnboarding: without it, interactive
# `claude` runs first-run onboarding (theme, then login screens) even when
# CLAUDE_CODE_OAUTH_TOKEN is set, which looks like the token being ignored.
COPY claude/ /etc/burst-harness/claude/
COPY burst-sandbox-init /usr/local/bin/burst-sandbox-init

# Driven from outside with exec; nothing to run on its own. A pod spec must set
# `args`, not `command`, or the entrypoint (and so the config) is skipped.
ENTRYPOINT ["burst-sandbox-init", "--"]
CMD ["sleep", "infinity"]
