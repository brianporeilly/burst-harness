#!/usr/bin/env python3
"""window-shot: run a native program on a virtual display (Xvfb), take a screenshot of it, and stop it.

  window-shot --wait 20 -- ./target/debug/my-game
  window-shot --size 720x1280 --wait 20 --step key:space --step wait:2 --step shot:after.png -- cargo run -q

The program's own output passes through. Exit status 1 when it exited before the last screenshot (its status is
printed). Rendering is Mesa's, in software (llvmpipe for OpenGL, lavapipe for Vulkan): what it draws is right, but
how fast it draws says nothing about a real device. Wait long enough for a first frame: a software renderer, and a
first run that compiles shaders, are slow.
"""

import argparse
import os
import re
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/burst-harness")
import shot_steps  # noqa: E402

XKEYS = {"Space": "space", "Enter": "Return", "ArrowLeft": "Left", "ArrowRight": "Right", "ArrowUp": "Up",
         "ArrowDown": "Down"}  # web-shot's names for the same keys


def display(size: str) -> tuple[subprocess.Popen, str]:
    read, write = os.pipe()
    xvfb = subprocess.Popen(["Xvfb", "-displayfd", str(write), "-screen", "0", f"{size}x24", "-nolisten", "tcp"],
                            pass_fds=(write,), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.close(write)
    number = b""
    while not number.endswith(b"\n"):
        chunk = os.read(read, 16)
        if not chunk:
            raise SystemExit("Xvfb didn't start.")
        number += chunk
    os.close(read)
    return xvfb, f":{number.decode().strip()}"


def stop(process: subprocess.Popen) -> None:
    if process.poll() is None:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(5)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=shot_steps.__doc__)
    parser.add_argument("--out", default="shot.png", help="the last screenshot (default shot.png)")
    parser.add_argument("--wait", type=float, default=15, help="seconds after the program starts, before the steps")
    parser.add_argument("--size", default="1280x720", help="the display, WxH")
    parser.add_argument("--step", action="append", default=[], help="input, a pause or a screenshot; see below")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="-- the program and its arguments")
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("say what to run, after --.")
    try:
        steps = [shot_steps.parse(step) for step in args.step]
    except ValueError as err:
        parser.error(str(err))
    if not re.fullmatch(r"\d+x\d+", args.size.lower()):
        parser.error(f"--size {args.size!r} is not WxH.")
    width, height = (int(n) for n in args.size.lower().split("x"))

    xvfb, number = display(f"{width}x{height}")
    env = {**os.environ, "DISPLAY": number}
    env.pop("WAYLAND_DISPLAY", None)  # winit would pick Wayland over X11
    started = time.monotonic()
    program = subprocess.Popen(command, env=env, start_new_session=True)

    def x(*argv: str) -> None:
        subprocess.run(argv, env=env, check=True)

    def shot(path: str) -> bool:
        if program.poll() is not None:
            print(f"The program exited (status {program.returncode}) after {time.monotonic() - started:.0f}s, "
                  f"before {path}.", file=sys.stderr)
            return False
        x("magick", "import", "-window", "root", path)
        print(f"Saved {path}.", flush=True)
        return True

    ok = True
    try:
        time.sleep(args.wait)
        x("xdotool", "mousemove", str(width // 2), str(height // 2))  # keys go to the window under the pointer
        for kind, *values in steps:
            if kind == "tap":
                x("xdotool", "mousemove", values[0], values[1], "click", "1")
            elif kind == "key":
                x("xdotool", "key", XKEYS.get(values[0], values[0]))
            elif kind == "type":
                x("xdotool", "type", "--delay", "50", values[0])
            elif kind == "wait":
                time.sleep(float(values[0]))
            elif kind == "shot":
                ok = shot(values[0]) and ok
            if kind in ("tap", "key", "type"):
                time.sleep(0.2)  # the frame after the input
        ok = shot(args.out) and ok
    finally:
        stop(program)
        xvfb.terminate()
        xvfb.wait()
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
